# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL
POSTGRES_DB=nexus_storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Object storage: "local" or "s3"
STORAGE_BACKEND=s3

# Antivirus: heuristic, clamav, or disabled
ANTIVIRUS_MODE=heuristic

# Default system super admin (created on migrate)
SUPERADMIN_EMAIL=superadmin@nexusstorage.local
SUPERADMIN_PASSWORD=SuperAdmin@12345
SUPERADMIN_NAME=System Super Admin

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Data Storage Management System <no-reply@cloudbasedstorage.local>

# Frontend
VITE_API_URL=http://localhost:8000/api

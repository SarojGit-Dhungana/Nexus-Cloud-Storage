# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL (required outside automated tests)
POSTGRES_DB=nexusstorage
POSTGRES_USER=nexusstorage
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Object storage: "local" for development, "s3" for Cloudflare R2/Supabase S3.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_QUERYSTRING_EXPIRE=900

# Antivirus: heuristic (default), clamav, or disabled
ANTIVIRUS_MODE=heuristic

# Default system super admin, created automatically on migrate.
# Change the password after the first sign-in.
SUPERADMIN_EMAIL=superadmin@nexusstorage.local
SUPERADMIN_PASSWORD=SuperAdmin@12345
SUPERADMIN_NAME=System Super Admin

# Email: leave defaults to print invite/share notifications to the API log.
# For real delivery via Gmail, create an App Password and set the values below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NexusStorage <no-reply@nexusstorage.local>

# AI: "ollama", "groq", or "disabled".
AI_PROVIDER=disabled
AI_MODEL=llama3.2:3b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_TIMEOUT_SECONDS=60

# Frontend
VITE_API_URL=http://localhost:8000/api

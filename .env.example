# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PRODUCT_NAME=Cloud Based Storage System

# PostgreSQL (required outside automated tests)
POSTGRES_DB=nexus_storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Object storage (boto3 + django-storages).
# Use "s3" for AWS S3 / Cloudflare R2 / MinIO / Supabase. Use "local" for disk under MEDIA_ROOT.
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_EXPIRE=900

# Antivirus: heuristic (default), clamav, or disabled
ANTIVIRUS_MODE=heuristic

# Default system super admin, created automatically on migrate.
# Change the password after the first sign-in.
SUPERADMIN_EMAIL=superadmin@nexusstorage.local
SUPERADMIN_PASSWORD=SuperAdmin@12345
SUPERADMIN_NAME=System Super Admin

# Email: console prints invite/share notifications to the API log.
# For real inbox delivery (Share → Send), use SMTP + a Gmail App Password:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cloud Based Storage System <no-reply@cloudbasedstorage.local>

# AI: "ollama", "groq", or "disabled".
# File content summaries use the local trainable model (nexus-file-analyzer),
# not OpenAI/Groq. Train with: python manage.py train_file_analyzer
AI_PROVIDER=disabled
AI_MODEL=llama3.2:3b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_TIMEOUT_SECONDS=60
FILE_ANALYSIS_ENABLED=true
FILE_ANALYSIS_MAX_SENTENCES=5

# Frontend
VITE_API_URL=http://localhost:8000/api
